{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
		    "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Debug-Master",
            "inherits": "Debug",
            "cacheVariables": {
                "CAN_NODE_ROLE": "MASTER"
            }
        },
        {
            "name": "Debug-Slave",
            "inherits": "Debug",
            "cacheVariables": {
                "CAN_NODE_ROLE": "SLAVE"
            }
        },
        {
            "name": "Debug-Loopback",
            "inherits": "Debug-Master",
            "cacheVariables": {
                "CAN_LOOPBACK_TEST": {
                    "type": "BOOL",
                    "value": "ON"
                }
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Debug-Master",
            "configurePreset": "Debug-Master"
        },
        {
            "name": "Debug-Slave",
            "configurePreset": "Debug-Slave"
        },
        {
            "name": "Debug-Loopback",
            "configurePreset": "Debug-Loopback"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        }
    ]
}
